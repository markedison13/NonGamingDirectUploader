<UserControl x:Class="NonGamingDirectUploader.Views.OnlineGamingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:NonGamingDirectUploader.Helpers">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One category "box" in an Uploader tab: label, Wager/Win inputs,
             an optional read-only Payout (FUNaloMAX only), and its own
             Submit button. The Button's Tag binds back to the
             CategoryEntryViewModel so code-behind knows which row to submit. -->
        <Style x:Key="CategoryBoxBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="CategoryFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Page header -->
            <RowDefinition Height="2*"/>
            <!-- Data Viewer tabs -->
            <RowDefinition Height="3*"/>
            <!-- Uploader tabs -->
        </Grid.RowDefinitions>

        <!-- ── PAGE HEADER ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="28,20,28,16"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Width="4" Height="22" CornerRadius="2" Background="{StaticResource AccentBlueBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Online Gaming" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="Table Games, SportsBook and FUNaloMAX — view existing records per date, and enter new Wager/Win figures per category."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ── DATA VIEWERS ────────────────────────────────────────────────── -->
        <TabControl Grid.Row="1" x:Name="DataViewerTabs" Margin="16,12,16,8">

            <TabItem Header="Table Games Data Viewer">
                <Grid x:Name="VirtualGamesViewerPanel" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Date:" Style="{StaticResource CategoryFieldLabel}" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding UploadDate, Mode=TwoWay}" Width="150" Margin="0,0,12,0"/>
                        <Button Content="⟳ Refresh" Style="{StaticResource GhostButton}" Click="RefreshVirtualGamesViewer_Click"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding PreviewData.DefaultView}" AutoGenerateColumns="True" IsReadOnly="True"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="SportsBook Data Viewer">
                <Grid x:Name="SportsBookViewerPanel" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Date:" Style="{StaticResource CategoryFieldLabel}" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding UploadDate, Mode=TwoWay}" Width="150" Margin="0,0,12,0"/>
                        <Button Content="⟳ Refresh" Style="{StaticResource GhostButton}" Click="RefreshSportsBookViewer_Click"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding PreviewData.DefaultView}" AutoGenerateColumns="True" IsReadOnly="True"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="FunaloMax Data Viewer">
                <Grid x:Name="FunaloViewerPanel" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Date:" Style="{StaticResource CategoryFieldLabel}" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding UploadDate, Mode=TwoWay}" Width="150" Margin="0,0,12,0"/>
                        <Button Content="⟳ Refresh" Style="{StaticResource GhostButton}" Click="RefreshFunaloViewer_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- MegaFunalo — daily total across every FUNaloMAX category -->
                        <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="MegaFunalo (daily total)" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="10,8"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding MegaFunaloData.DefaultView}" AutoGenerateColumns="True" IsReadOnly="True"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Border>

                        <!-- Per-category FunaloMax rows -->
                        <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding PreviewData.DefaultView}" AutoGenerateColumns="True" IsReadOnly="True"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ── UPLOADERS ───────────────────────────────────────────────────── -->
        <TabControl Grid.Row="2" x:Name="UploaderTabs" Margin="16,8,16,16">

            <TabItem Header="Table Games Uploader">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}">
                    <StackPanel x:Name="VirtualGamesUploaderPanel" Margin="12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Date:" Style="{StaticResource CategoryFieldLabel}" Margin="0,0,8,0"/>
                            <DatePicker SelectedDate="{Binding UploadDate, Mode=TwoWay}" Width="150"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CategoryBoxBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Wager" Style="{StaticResource CategoryFieldLabel}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding WagerText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Win" Style="{StaticResource CategoryFieldLabel}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding WinText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="SUBMIT" Style="{StaticResource PrimaryButton}"
                                                    VerticalAlignment="Top" Width="90" Margin="14,0,0,0"
                                                    Tag="{Binding}" Click="SubmitVirtualGamesCategory_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="SUBMIT ALL" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left"
                                Width="160" Click="SubmitAllVirtualGames_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SportsBook Uploader">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}">
                    <StackPanel x:Name="SportsBookUploaderPanel" Margin="12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Date:" Style="{StaticResource CategoryFieldLabel}" Margin="0,0,8,0"/>
                            <DatePicker SelectedDate="{Binding UploadDate, Mode=TwoWay}" Width="150"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CategoryBoxBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Wager" Style="{StaticResource CategoryFieldLabel}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding WagerText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Win" Style="{StaticResource CategoryFieldLabel}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding WinText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="SUBMIT" Style="{StaticResource PrimaryButton}"
                                                    VerticalAlignment="Top" Width="90" Margin="14,0,0,0"
                                                    Tag="{Binding}" Click="SubmitSportsBookCategory_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="SUBMIT ALL" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left"
                                Width="160" Click="SubmitAllSportsBook_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="FunaloMax Uploader">
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}">
                    <StackPanel x:Name="FunaloUploaderPanel" Margin="12">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Date:" Style="{StaticResource CategoryFieldLabel}" Margin="0,0,8,0"/>
                            <DatePicker SelectedDate="{Binding UploadDate, Mode=TwoWay}" Width="150"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CategoryBoxBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Wager" Style="{StaticResource CategoryFieldLabel}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding WagerText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Win" Style="{StaticResource CategoryFieldLabel}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding WinText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <!-- The "twist": Payout = Wager - Win, derived and read-only. -->
                                                <Grid Visibility="{Binding ShowPayout, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Payout" Style="{StaticResource CategoryFieldLabel}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PayoutDisplay}"
                                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="SUBMIT" Style="{StaticResource PrimaryButton}"
                                                    VerticalAlignment="Top" Width="90" Margin="14,0,0,0"
                                                    Tag="{Binding}" Click="SubmitFunaloCategory_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="SUBMIT ALL" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left"
                                Width="160" Click="SubmitAllFunalo_Click"/>
                        <TextBlock Text="Submitting any category here also recomputes the MegaFunalo daily totals shown on the Data Viewer tab."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

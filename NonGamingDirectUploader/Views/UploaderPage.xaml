<UserControl x:Class="NonGamingDirectUploader.Views.UploaderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Per-row Edit / Delete buttons for the last column of the preview grid -->
        <DataTemplate x:Key="RowActionsTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Edit" Tag="{Binding}" Click="EditRow_Click"
                        FontSize="11" Padding="10,4" Margin="0,0,6,0"
                        Background="Transparent"
                        Foreground="{StaticResource AccentBlueBrush}"
                        BorderBrush="{StaticResource AccentBlueBrush}"
                        BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Delete" Tag="{Binding}" Click="DeleteRow_Click"
                        FontSize="11" Padding="10,4"
                        Background="Transparent"
                        Foreground="{StaticResource AccentRedBrush}"
                        BorderBrush="{StaticResource AccentRedBrush}"
                        BorderThickness="1" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Page header -->
            <RowDefinition Height="*"/>
            <!-- Body -->
        </Grid.RowDefinitions>

        <!-- ── PAGE HEADER ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="28,20,28,16"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border x:Name="AccentBar" Width="4" Height="22" CornerRadius="2"
                                Background="{StaticResource AccentBlueBrush}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleBlock"
                                   Text="Others Uploader"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock x:Name="SubtitleBlock"
                               Text="Upload daily or monthly data to NonGaming.accdb"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="14,0,0,0"/>
                </StackPanel>

                <!-- Status badge -->
                <Border Grid.Column="1" CornerRadius="20" Padding="12,6"
                        Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                 Fill="{StaticResource TextMutedBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusBadgeText"
                                   Text="Not Connected"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ── BODY ────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <!-- Left config panel -->
                <ColumnDefinition Width="*"/>
                <!-- Right data panel -->
            </Grid.ColumnDefinitions>

            <!-- ── LEFT CONFIGURATION PANEL ─────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <!--
                    FIX: this ScrollViewer previously relied on the app's
                    implicit ScrollViewer style, which was ALSO leaking into
                    DataGrid's internal scroll viewer and forcing its
                    horizontal scrollbar off everywhere. That implicit style
                    is now keyed (AppScrollViewerStyle) in DarkTheme.xaml, so
                    it must be applied explicitly here to keep this panel's
                    original "vertical scroll only" behavior.
                -->
                <ScrollViewer Style="{StaticResource AppScrollViewerStyle}">
                    <StackPanel Margin="24,20,24,20" >

                        <!-- DATABASE SECTION (auto-assigned per module + property, no manual selection) -->
                        <TextBlock Text="DATABASE" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Border Background="{StaticResource BgElevatedBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Assigned database (auto-resolved by module + property)"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock x:Name="DbPathText"
                                           Text="No database selected…"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button Content="⟳  Test Connection" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch"
                                Click="TestConn_Click" Margin="0,0,0,20"/>

                        <Separator Margin="0,0,0,20"/>

                        <!-- UPLOAD MODE -->
                        <TextBlock Text="UPLOAD MODE" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DailyTab" Grid.Column="0"
                                    Background="{StaticResource AccentBlueBrush}"
                                    CornerRadius="6,0,0,6" Padding="0,8">
                                <TextBlock Text="Daily" Foreground="White" FontSize="13"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{x:Null}"/>
                                </Border.InputBindings>
                            </Border>
                            <Border x:Name="MonthlyTab" Grid.Column="1"
                                    Background="{StaticResource BgElevatedBrush}"
                                    CornerRadius="0,6,6,0" Padding="0,8"
                                    Cursor="Hand" MouseDown="MonthlyTab_Click">
                                <TextBlock Text="Monthly" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- click handlers on code-behind -->
                            <Border Grid.Column="0" Background="Transparent" Cursor="Hand"
                                    MouseDown="DailyTab_Click"/>
                        </Grid>

                        <!-- DAILY DATE -->
                        <StackPanel x:Name="DailySection" Visibility="Visible">
                            <TextBlock Text="Date to Extract / Upload" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DailyDatePicker" Margin="0,0,0,20"
                                        SelectedDateChanged="DailyDate_Changed"/>
                        </StackPanel>

                        <!-- MONTHLY / DATE RANGE — driven directly by Start/End pickers, no Month dropdown -->
                        <StackPanel x:Name="MonthlySection" Visibility="Collapsed">
                            <TextBlock Text="Date Range to Extract / Upload" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Start Date" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="StartDatePicker" SelectedDateChanged="StartDate_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="End Date" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="EndDatePicker" SelectedDateChanged="EndDate_Changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Separator Margin="0,4,0,20"/>

                        <!-- ACTIONS -->
                        <TextBlock Text="ACTIONS" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>

                        <Button Content="⬇  Get Data from Database" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Click="GetData_Click"/>

                        <Button Content="📁  Bulk Upload (Excel)" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Click="BulkUpload_Click" Visibility="Collapsed"/>

                        <Button x:Name="UploadBtn" Content="⬆  Upload to Database"
                                Style="{StaticResource SuccessButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Click="BulkUpload_Click"/>

                        <Button Content="✕  Clear Log" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,0"
                                Click="ClearLog_Click"/>

                        <Separator Margin="0,20,0,20"/>

                        <!-- STATUS -->
                        <TextBlock Text="STATUS" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                        <!-- Progress bar -->
                        <Border Background="{StaticResource BgElevatedBrush}"
                                CornerRadius="4" Height="6" Margin="0,0,0,8"
                                ClipToBounds="True">
                            <Border x:Name="ProgressFill"
                                    Background="{StaticResource AccentGreenBrush}"
                                    CornerRadius="4" Width="0"
                                    HorizontalAlignment="Left"/>
                        </Border>

                        <TextBlock x:Name="StatusText"
                                   Text="Ready."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock x:Name="RowCountText"
                                   Text="0 records"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── RIGHT DATA PANEL ───────────────────────────────────────── -->
            <Grid Grid.Column="1" Background="{StaticResource BgSurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Data grid -->
                    <RowDefinition Height="160"/>
                    <!-- Log -->
                </Grid.RowDefinitions>

                <!-- Data preview grid -->
                <Border Grid.Row="0" Margin="20,16,20,0"
                        Background="{StaticResource BgCardBrush}"
                        CornerRadius="8" ClipToBounds="True"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Background="{StaticResource BgElevatedBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Data Preview" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RecordCountBadge"
                                           Text="0 records"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyState" Grid.Row="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⊡" FontSize="48" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="No data loaded" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock Text="Click 'Get Data' to fetch, or 'Bulk Upload' to load from Excel"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Columns are built manually in code-behind from the VM's
                             PreviewColumns list (fixed set, in order, DTE date-only).
                             AutoGenerateColumns is off. First column (Actions) is
                             frozen so Edit/Delete stay visible while scrolling.
                             Vertical scrollbar is forced Visible (not Auto) so it's
                             never mistaken for missing when there's more than a
                             screenful of rows. Horizontal scrollbar is Auto — it
                             now actually appears once column widths (Auto-sized in
                             code-behind) exceed the panel's width. -->
                        <DataGrid x:Name="PreviewGrid" Grid.Row="1"
                                  Visibility="Collapsed"
                                  AutoGenerateColumns="False"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Visible"
                                  CanUserResizeColumns="True"
                                  FrozenColumnCount="1"
                                  Margin="0,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Activity log -->
                <Border Grid.Row="1" Margin="20,10,20,16"
                        Background="{StaticResource BgCardBrush}"
                        CornerRadius="8" ClipToBounds="True"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,8"
                                Background="{StaticResource BgElevatedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="Activity Log" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" FontWeight="SemiBold"/>
                        </Border>

                        <ListBox x:Name="LogList" Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 FontSize="11"
                                 FontFamily="Consolas"
                                 Padding="12,6"/>
                    </Grid>
                </Border>

                <!-- Busy overlay -->
                <Grid Grid.RowSpan="2" x:Name="BusyOverlay"
                      Background="#88000000"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource AccentBlueBrush}"
                                BorderThickness="2">
                            <TextBlock Text="⟳" FontSize="24" Foreground="{StaticResource AccentBlueBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="BusyText" Text="Processing…"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

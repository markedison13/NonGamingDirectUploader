<Window x:Class="NonGamingDirectUploader.Views.BulkUploadPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Upload Preview"
        Height="560" Width="820"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeepBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Text="Bulk Upload Preview" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="SubtitleText" Text="Review the data below, then click Upload."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="PreviewGrid"
                      AutoGenerateColumns="True"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="⬆ Upload" Style="{StaticResource SuccessButton}" Width="120" Click="Upload_Click"/>
        </StackPanel>
    </Grid>
</Window>

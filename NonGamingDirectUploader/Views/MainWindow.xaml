<Window x:Class="NonGamingDirectUploader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="OOD Uploader — FI-FP&amp;A Dashboard"
        Height="780" Width="1280"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Accent dot for nav icons -->
        <Style x:Key="AccentDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left dock sidebar -->
                <ColumnDefinition Width="220"/>
                <!-- Content area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!--  LEFT DOCK SIDEBAR                                             -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="*"/>
                        <!-- Nav items -->
                        <RowDefinition Height="Auto"/>
                        <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Sidebar header -->
                    <Border Grid.Row="0" Padding="16,20,16,12"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="MODULES" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" FontWeight="Bold" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Select uploader" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Nav buttons -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">

                        <!-- ── NONGAMING NAV ─────────────────────────────────── -->
                        <StackPanel x:Name="NonGamingNavPanel" Visibility="Visible">

                            <!-- Others -->
                            <Button x:Name="NavOthers" Click="Nav_Click" Tag="Others"
                                    Style="{StaticResource NavButtonActive}">
                                <Grid Width="165">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                            Background="#1A2F81F7" Margin="0,0,10,0">
                                        <TextBlock Text="⊙" Foreground="#FF2F81F7" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Others" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="NonGaming · Other" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Ellipse x:Name="DotOthers" Grid.Column="2"
                                             Width="6" Height="6" Fill="#FF2F81F7"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- F&B -->
                            <Button x:Name="NavFnB" Click="Nav_Click" Tag="FnB"
                                    Style="{StaticResource NavButton}">
                                <Grid Width="165">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                            Background="#1A3FB950" Margin="0,0,10,0">
                                        <TextBlock Text="⚑" Foreground="#FF3FB950" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="F&amp;B" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Food &amp; Beverage" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Ellipse x:Name="DotFnB" Grid.Column="2"
                                             Width="6" Height="6" Fill="#FF3FB950"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>

                            <!-- Hotel -->
                            <Button x:Name="NavHotel" Click="Nav_Click" Tag="Hotel"
                                    Style="{StaticResource NavButton}">
                                <Grid Width="165">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                            Background="#1AFF8C00" Margin="0,0,10,0">
                                        <TextBlock Text="⌂" Foreground="#FFFF8C00" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Hotel" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Rooms &amp; Revenue" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Ellipse x:Name="DotHotel" Grid.Column="2"
                                             Width="6" Height="6" Fill="#FFFF8C00"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>

                            <!-- Visitation -->
                            <Button x:Name="NavVisitation" Click="Nav_Click" Tag="Visitation"
                                    Style="{StaticResource NavButton}">
                                <Grid Width="165">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                            Background="#1A8957E5" Margin="0,0,10,0">
                                        <TextBlock Text="◈" Foreground="#FF8957E5" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Visitation" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Patron &amp; Traffic" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Ellipse x:Name="DotVisitation" Grid.Column="2"
                                             Width="6" Height="6" Fill="#FF8957E5"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>

                        </StackPanel>

                        <!-- ── GAMING NAV ────────────────────────────────────── -->
                        <StackPanel x:Name="GamingNavPanel" Visibility="Collapsed">

                            <!-- Mass -->
                            <Button x:Name="NavMass" Click="Nav_Click" Tag="Mass"
                                    Style="{StaticResource NavButtonActive}">
                                <Grid Width="165">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                            Background="#1AE3B341" Margin="0,0,10,0">
                                        <TextBlock Text="♠" Foreground="#FFE3B341" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Mass" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Gaming · Mass Tables" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Ellipse x:Name="DotMass" Grid.Column="2"
                                             Width="6" Height="6" Fill="#FFE3B341"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- VIP -->
                            <Button x:Name="NavVIP" Click="Nav_Click" Tag="VIP"
                                    Style="{StaticResource NavButton}">
                                <Grid Width="165">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                            Background="#1ADB61A2" Margin="0,0,10,0">
                                        <TextBlock Text="♦" Foreground="#FFDB61A2" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="VIP" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Gaming · VIP Tables" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Ellipse x:Name="DotVIP" Grid.Column="2"
                                             Width="6" Height="6" Fill="#FFDB61A2"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>

                            <!-- Junket -->
                            <Button x:Name="NavJunket" Click="Nav_Click" Tag="Junket"
                                    Style="{StaticResource NavButton}">
                                <Grid Width="165">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                            Background="#1A39C5CF" Margin="0,0,10,0">
                                        <TextBlock Text="♣" Foreground="#FF39C5CF" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Junket" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Gaming · Junket" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <Ellipse x:Name="DotJunket" Grid.Column="2"
                                             Width="6" Height="6" Fill="#FF39C5CF"
                                             VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Button>

                        </StackPanel>

                    </Grid>

                    <!-- Sidebar footer -->
                    <Border Grid.Row="2" Padding="16,12"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Text="PROPERTY" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <RadioButton x:Name="RadioSEC" Content="SEC Property" IsChecked="True"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             FontSize="12" GroupName="Property"
                                             Checked="Property_Checked"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="RadioSN" Content="SN Property"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             FontSize="12" GroupName="Property"
                                             Checked="Property_Checked"/>
                            </StackPanel>

                            <Button Content="▶  Run Automation Now" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                    Click="RunAutomation_Click"/>
                            <TextBlock Text="FI-FP&amp;A · OOD System" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="v2.0 — WPF Edition" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="Daily import runs via Task Scheduler at 5:00 AM" FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!--  CONTENT AREA                                                  -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Background="{StaticResource BgSurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <!-- Title bar -->
                    <RowDefinition Height="*"/>
                    <!-- Page content -->
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0" Background="{StaticResource BgDeepBrush}"
                        MouseDown="TitleBar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo + title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                            <Border Width="24" Height="24" CornerRadius="6"
                                    Background="{StaticResource AccentBlueBrush}" Margin="0,0,10,0">
                                <TextBlock Text="⇑" Foreground="White" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="OOD Uploader" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text=" · FI-FP&amp;A" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Active page label -->
                        <TextBlock Grid.Column="1" x:Name="PageLabel"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <!-- Right side: NonGaming/Gaming switch + window controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <ComboBox x:Name="BusinessLineCombo" Width="130" Margin="0,0,16,0"
                                      SelectionChanged="BusinessLineCombo_Changed">
                                <ComboBoxItem Content="NonGaming" IsSelected="True"/>
                                <ComboBoxItem Content="Gaming"/>
                            </ComboBox>

                            <Button x:Name="MinBtn" Content="─" Width="32" Height="28"
                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="12" Cursor="Hand"
                                    Click="MinBtn_Click"/>
                            <Button x:Name="MaxBtn" Content="□" Width="32" Height="28"
                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="12" Cursor="Hand"
                                    Click="MaxBtn_Click"/>
                            <Button x:Name="CloseBtn" Content="✕" Width="32" Height="28"
                                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                    BorderThickness="0" FontSize="12" Cursor="Hand"
                                    Click="CloseBtn_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FFFF4444"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page host — pages are created in code-behind so the main XAML
                     does not need to resolve the UploaderPage type at design time. -->
                <ContentControl x:Name="PageHost" Grid.Row="1"/>
            </Grid>

        </Grid>
    </Border>
</Window>
